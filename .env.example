# Copiar a .env.local y llenar. .env.local NUNCA se commitea.
# Todo tiene default: el proyecto arranca sin este archivo, con pago Bre-B
# manual y tarifa de envío propia.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================================== PAGOS

# 'breb-manual' (activo hoy) | 'wompi'
PAYMENT_PROVIDER=breb-manual

# Minutos que un pedido espera el pago antes de expirar. 1440 = 24 h.
PAYMENT_TTL_MINUTES=1440

# --- Bre-B manual (lo que ve el cliente en la pantalla de pago)
BREB_KEY=@farazu
BREB_KEY_TYPE=Llave alfanumérica
BREB_HOLDER=Vivero Verde Suculento
BREB_BANK=RappiCuenta
# Opcional: alternativa para quien no tenga Bre-B activo todavía.
BREB_NEQUI_FALLBACK=

# --- Wompi (dejar vacío hasta tener la cuenta; el sistema cae a breb-manual)
# Pedir llaves de TEST desde el día 1: no exigen licencia activa.
# Configurar la URL de eventos en el dashboard apuntando a:
#   https://<dominio>/api/webhooks/payments
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
# Sandbox por defecto. Producción: https://production.wompi.co/v1
WOMPI_BASE_URL=https://api-sandbox.co.uat.wompi.dev/v1

# ============================================================== ENVÍOS

# 'tarifa-propia' (activo hoy) | 'mipaquete' | 'envia'
SHIPPING_PROVIDER=tarifa-propia

# Compra mínima para envío gratis. 0 lo desactiva.
SHIPPING_FREE_FROM=120000
# Mismo valor, visible en el navegador (el carrito lo usa para el mensaje
# "te faltan $X para envío gratis" sin llamar a la API). Next.js solo expone
# al cliente las variables con prefijo NEXT_PUBLIC_, así que hay que
# repetirlo aquí — si cambias SHIPPING_FREE_FROM, cambia este también.
NEXT_PUBLIC_SHIPPING_FREE_FROM=120000

# Bodega de despacho: origen de todas las guías.
SHIPPING_ORIGIN_DEPT=Cundinamarca
SHIPPING_ORIGIN_CITY=Soacha
SHIPPING_ORIGIN_CITY_CODE=25754000
SHIPPING_ORIGIN_ADDRESS=Calle 6 # 3c-08

# Contra entrega. Dejar en false hasta que un agregador confirme cobertura de
# recaudo: ofrecerlo sin recaudo real es despachar producto que nadie cobra.
SHIPPING_COD_ENABLED=false

# --- Mipaquete
MIPAQUETE_API_KEY=
MIPAQUETE_BASE_URL=https://api-v2.dev.mipaquete.com

# --- Envia.com  (probado 2026-08-07 — ver docs/envia-setup.md)
# OJO: la llave sirve SOLO en el ambiente donde se creó. Una llave de
# producción da 401 contra api-test y viceversa. ENVIA_BASE_URL tiene que
# coincidir con el ambiente de la llave, o el 401 te hará creer que la llave
# está mala.
ENVIA_TOKEN=
ENVIA_BASE_URL=https://api-test.envia.com   # producción: https://api.envia.com

# Secreto compartido para validar los webhooks de la transportadora.
SHIPPING_WEBHOOK_SECRET=

# ============================================================== ADMIN

# Token para llamar a las rutas /api/admin/* por script/curl (cron manual,
# depuración). NO es lo que usa el panel del navegador — eso es el login de
# abajo. Generar uno largo y aleatorio:  openssl rand -hex 32
ADMIN_API_TOKEN=

# --- Login del panel /admin (navegador humano)
# Sin las tres variables de esta sección, /admin/login responde 503. Con
# ellas, el panel deja de depender de compartir ADMIN_API_TOKEN a mano.
#
# ADMIN_EMAIL: el correo con el que entra tu cliente. Cualquier valor sirve,
# no se verifica contra nada externo, solo identifica la cuenta (hoy hay una
# sola).
#
# ADMIN_PASSWORD_HASH: NUNCA la contraseña en texto plano. Generar el hash así
# (cambia "la-contraseña-real" por la contraseña real, una sola vez, y borra
# el comando de tu historial de terminal después si te preocupa que quede
# guardado):
#
#   node -e "const c=require('crypto');const s=c.randomBytes(16).toString('hex');console.log(s+':'+c.scryptSync(process.argv[1],s,64).toString('hex'))" "la-contraseña-real"
#
# Copiar TODA la salida (salt:hash) tal cual a esta variable.
#
# ADMIN_SESSION_SECRET: openssl rand -hex 32 — firma la cookie de sesión.
# Cambiarlo cierra la sesión de todo el mundo (útil si alguna vez hay que
# revocar acceso de golpe, sin cambiar la contraseña).
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Vencimiento automático de pedidos sin pagar. SIN ESTO, LOS PEDIDOS SIN
# PAGAR NUNCA EXPIRAN SOLOS — hay que cerrarlos a mano desde el panel.
#
# Generarlo tú: openssl rand -hex 32. Pégalo aquí Y configúralo como el
# secreto que use el programador externo (cron de Railway, GitHub Actions,
# cron-job.org…) para llamar a GET /api/admin/expirar una vez al día con
# el header `Authorization: Bearer $CRON_SECRET`. Ver docs/railway-deploy.md.
CRON_SECRET=

# ======================================================= ALMACENAMIENTO

# OBLIGATORIO EN PRODUCCIÓN si despliegas en Vercel, Netlify o cualquier
# serverless. Allí cada ruta corre en una función distinta, con su propia
# memoria y su propio disco: un pedido guardado en archivo se crea en una
# función y desaparece para todas las demás.
#
# Sin esto configurado en serverless, el checkout SE NIEGA a crear pedidos
# (mejor eso que cobrar y perder la orden) y el panel muestra la alerta.
#
# En Railway (servidor propio, no serverless) esa negativa NO se activa sola
# — el checkout aceptaría pedidos igual usando el archivo. Pero el disco de
# Railway se borra en cada redeploy si no hay un Volume montado. Recomendado
# igual: configurar Redis aquí también, y así da lo mismo cuántas veces se
# redeploye. Ver docs/railway-deploy.md.
#
# Mismas credenciales las reutiliza el rate limiting (lib/ratelimit.ts) Y el
# catálogo editable del admin (lib/catalog/store.ts) — configurar esto una
# vez cubre las tres cosas. SIN esto, el catálogo del admin (/admin/catalogo)
# queda de solo lectura: se puede ver pero no guardar ningún cambio.
#
# Cómo obtenerlo (3 minutos, gratis):
#   Directo → upstash.com → Create Database → copia REST URL y REST TOKEN.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# En local no hace falta: sin Redis se usa este archivo, que ahí sí funciona.
# En Railway, solo es seguro sin Redis si hay un Volume montado en esta ruta.
ORDERS_FILE=.data/orders.json

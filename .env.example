# Copiar a .env.local y llenar. .env.local NUNCA se commitea.
# Todo tiene default: el proyecto arranca sin este archivo, con pago Bre-B
# manual y tarifa de envío propia.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================================== PAGOS

# 'breb-manual' (activo hoy) | 'wompi'
PAYMENT_PROVIDER=breb-manual

# Minutos que un pedido espera el pago antes de expirar. 1440 = 24 h.
PAYMENT_TTL_MINUTES=1440

# --- Bre-B manual (lo que ve el cliente en la pantalla de pago)
BREB_KEY=@farazu
BREB_KEY_TYPE=Llave alfanumérica
BREB_HOLDER=Vivero Verde Suculento
BREB_BANK=RappiCuenta
# Opcional: alternativa para quien no tenga Bre-B activo todavía.
BREB_NEQUI_FALLBACK=

# --- Wompi (dejar vacío hasta tener la cuenta; el sistema cae a breb-manual)
# Pedir llaves de TEST desde el día 1: no exigen licencia activa.
# Configurar la URL de eventos en el dashboard apuntando a:
#   https://<dominio>/api/webhooks/payments
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
# Sandbox por defecto. Producción: https://production.wompi.co/v1
WOMPI_BASE_URL=https://sandbox.wompi.co/v1

# ============================================================== ENVÍOS

# 'tarifa-propia' (activo hoy) | 'mipaquete' | 'envia'
SHIPPING_PROVIDER=tarifa-propia

# Sin envío gratis (decisión del cliente, 2026-11-13): SHIPPING_FREE_FROM ya no se usa.

# Bodega de despacho: origen de todas las guías.
SHIPPING_ORIGIN_DEPT=Cundinamarca
SHIPPING_ORIGIN_CITY=Soacha
SHIPPING_ORIGIN_CITY_CODE=25754000
SHIPPING_ORIGIN_ADDRESS=Calle 6 # 13-08

# Contra entrega (habilitado a pedido del cliente, recaudo con Interrapidísimo). Poner false para apagarlo:
# ofrecerlo sin recaudo real es despachar producto que nadie cobra.
SHIPPING_COD_ENABLED=true
# Porcentaje del recaudo que se le suma al cliente por pagar contra entrega. 0 = lo asume el vivero
# (Interrapidísimo descuenta su comisión de lo que recauda; confirmar la tarifa real con ellos).
SHIPPING_COD_FEE_PCT=0
# Cargo fijo que se suma al ENVÍO del cliente por pagar contra entrega (no sale como línea aparte). 0 = lo asume el vivero.
SHIPPING_COD_FEE=4500
# Pedido mínimo y máximo (total con envío) para ofrecer contra entrega. 0 en el máximo = sin tope.
SHIPPING_COD_MIN=50000
SHIPPING_COD_MAX=800000
# false = el pedido contra entrega espera confirmación por WhatsApp y se genera la guía a mano (panel > Generar guía).
SHIPPING_COD_AUTO_GUIDE=false
# Costo del domicilio de entrega el mismo día (Soacha, Bogotá y Mosquera). 0 = se confirma por WhatsApp.
SHIPPING_SAME_DAY_FEE=0

# --- Mipaquete
MIPAQUETE_API_KEY=
MIPAQUETE_BASE_URL=https://api-v2.dev.mipaquete.com

# --- Envia.com  (probado 2026-08-07 — ver docs/envia-setup.md)
# OJO: la llave sirve SOLO en el ambiente donde se creó. Una llave de
# producción da 401 contra api-test y viceversa. ENVIA_BASE_URL tiene que
# coincidir con el ambiente de la llave, o el 401 te hará creer que la llave
# está mala.
ENVIA_TOKEN=
ENVIA_BASE_URL=https://api-test.envia.com   # producción: https://api.envia.com

# Secreto compartido para validar los webhooks de la transportadora.
SHIPPING_WEBHOOK_SECRET=

# ============================================================== ADMIN

# Token para llamar a las rutas /api/admin/* por script/curl (cron manual,
# depuración). NO es lo que usa el panel del navegador — eso es el login de
# abajo. Generar uno largo y aleatorio:  openssl rand -hex 32
ADMIN_API_TOKEN=

# --- Login del panel /admin (Better Auth: Google + enlace al correo, sin contraseñas)
# ADMIN_EMAILS: lista BLANCA y cerrada de correos que pueden entrar, separados por coma. Cualquier otro correo
# (aunque tenga cuenta de Google) es rechazado; quitar uno de aquí corta su acceso al instante. Sin esto nadie entra.
# BETTER_AUTH_SECRET: openssl rand -hex 32. OBLIGATORIO en producción. Cambiarlo cierra todas las sesiones.
# NEXT_PUBLIC_SITE_URL (arriba) debe ser la URL pública exacta: de ahí salen los enlaces y el retorno de Google.
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET: credencial OAuth "Aplicación web" de Google Cloud Console. URI de
#   redirección autorizada: <NEXT_PUBLIC_SITE_URL>/api/auth/callback/google  (opcional: sin ellas no sale el botón).
# RESEND_API_KEY / RESEND_FROM: para el enlace al correo (resend.com; el dominio del remitente debe estar verificado).
#   RESEND_FROM="Verde Suculento <acceso@tudominio.com>". En desarrollo, sin esto el enlace se imprime en la consola.
ADMIN_EMAILS=
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
RESEND_FROM=

# Vencimiento automático de pedidos sin pagar. SIN ESTO, LOS PEDIDOS SIN
# PAGAR NUNCA EXPIRAN SOLOS — hay que cerrarlos a mano desde el panel.
#
# Generarlo tú: openssl rand -hex 32. Pégalo aquí Y configúralo como el
# secreto que use el programador externo (cron de Railway, GitHub Actions,
# cron-job.org…) para llamar a GET /api/admin/expirar una vez al día con
# el header `Authorization: Bearer $CRON_SECRET`. Ver docs/railway-deploy.md.
CRON_SECRET=

# ======================================================= ALMACENAMIENTO

# OBLIGATORIO EN PRODUCCIÓN si despliegas en Vercel, Netlify o cualquier
# serverless. Allí cada ruta corre en una función distinta, con su propia
# memoria y su propio disco: un pedido guardado en archivo se crea en una
# función y desaparece para todas las demás.
#
# Sin esto configurado en serverless, el checkout SE NIEGA a crear pedidos
# (mejor eso que cobrar y perder la orden) y el panel muestra la alerta.
#
# En Railway (servidor propio, no serverless) esa negativa NO se activa sola
# — el checkout aceptaría pedidos igual usando el archivo. Pero el disco de
# Railway se borra en cada redeploy si no hay un Volume montado. Recomendado
# igual: configurar Redis aquí también, y así da lo mismo cuántas veces se
# redeploye. Ver docs/railway-deploy.md.
#
# Redis PROPIO (TCP, sin límites): pedidos, catálogo editable, promociones y cupones,
# imágenes del admin, contraseña del admin y rate limiting. SIN esto el admin queda
# de solo lectura. Local: ver docs/redis-local.md (contenedor Docker de una línea).
# Railway: REDIS_URL=${{Redis.REDIS_URL}}
REDIS_URL=redis://127.0.0.1:6379

# Mercado Libre (API oficial, solo lectura) para sincronizar precios y disponibilidad
# desde /admin/catalogo. App ID y Client Secret de la app en developers.mercadolibre.com.co.
ML_APP_ID=
ML_CLIENT_SECRET=

# En local no hace falta: sin Redis se usa este archivo, que ahí sí funciona.
# En Railway, solo es seguro sin Redis si hay un Volume montado en esta ruta.
ORDERS_FILE=.data/orders.json

# SOLO DESARROLLO: abre /admin sin login para revisar lo visual. Se ignora en producción.
# Cuando exista el proveedor de identidad (IDP), esta variable se elimina.
ADMIN_DEV_OPEN=

# --- Seguridad / red ---
# Cuántos proxies hay delante del sitio (Railway = 1). Se usa para leer la IP real del cliente en los límites de peticiones.
# Si más adelante se pone Cloudflare delante de Railway, cambiar a 2.
TRUSTED_PROXY_HOPS=1
# En Railway se usa x-real-ip automáticamente (su borde la sobrescribe). En otro proveedor: activar solo si el proxy la fija.
# TRUST_X_REAL_IP=1

# --- reCAPTCHA v3 (Google): protege el login del panel, el checkout y «Mis pedidos» contra bots.
# Sin estas dos variables el sitio funciona igual y no bloquea a nadie. Con las dos, se exige el token en el servidor.
# Ver docs/recaptcha.md para crear las llaves. La pública se lee en build: ponla antes de desplegar.
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=
# Puntuación mínima (0 a 1). Google recomienda 0.5 para empezar.
# RECAPTCHA_MIN_SCORE=0.5
